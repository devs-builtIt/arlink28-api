{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=arlink28_dev;Username=arlink28admin;Password=PLACEHOLDER_USE_USER_SECRETS"
  },
  "AppSettings": {
    "Secret": "REPLACE_WITH_STRONG_SECRET_KEY_MIN_32_CHARS",
    "ValidAudience": "https://localhost:5001",
    "ValidIssuer": "https://localhost:5001",
    "WebUrl": "https://localhost:5001",
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "MediaStorage": {
    "Provider": "LocalDisk",
    "RootPath": "local-storage/media",
    "MaxFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "EmailSettings": {
    "FromName": "ARLink28",
    "FromEmail": "noreply@arlink28.com",
    "SmtpHost": "PLACEHOLDER_SET_IN_DEVELOPMENT_JSON",
    "SmtpPort": 587,
    "SmtpUser": "PLACEHOLDER_USE_USER_SECRETS",
    "SmtpPass": "PLACEHOLDER_USE_USER_SECRETS",
    "EnableSsl": true
  },
  "EnquirySettings": {
    "NotifyTo": ""
  },
  "AdminBootstrap": {
    "Enabled": false,
    "Username": "superadmin",
    "Email": "PLACEHOLDER_ADMIN_EMAIL",
    "Password": "PLACEHOLDER_USE_USER_SECRETS"
  },
  "AllowedHosts": "*"
}
